{
  "name": "bencica-ui",
  "version": "0.1.0",
  "description": "The dark, pixel-typed Svelte 5 design language of bencica.hu.",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "FONT-NOTICE.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./base.css": "./dist/styles/base.css",
    "./font.css": "./dist/styles/font.css",
    "./styles.css": "./dist/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package",
    "watch": "svelte-package --watch",
    "prepare": "npm run build",
    "prepack": "npm run check && npm run build"
  },
  "peerDependencies": {
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haverfalat/bencica-ui.git"
  },
  "homepage": "https://github.com/haverfalat/bencica-ui#readme",
  "bugs": {
    "url": "https://github.com/haverfalat/bencica-ui/issues"
  }
}
